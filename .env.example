# =============================================================================
# Salin ke .env lalu isi nilainya. JANGAN commit file .env.
# =============================================================================

# --- Aplikasi -----------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="Undangku"
# URL utama aplikasi (dashboard, landing)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Domain root untuk subdomain undangan: {slug}.ROOT_DOMAIN
# KOSONG = subdomain nonaktif → link undangan {APP_URL}/u/{slug} (staging tanpa domain).
# Lokal: "localhost:3000" (akses via slug.localhost:3000 di Chrome).
# Ditanam saat build: setelah mengubah, build/deploy ulang. Lihat docs/DEPLOY.md.
NEXT_PUBLIC_ROOT_DOMAIN=""

# --- Database -----------------------------------------------------------------
# Lokal (docker compose): postgresql://undangan:undangan@localhost:5432/undangan
DATABASE_URL="postgresql://undangan:undangan@localhost:5432/undangan?schema=public"

# --- Auth.js ------------------------------------------------------------------
# Buat dengan: npx auth secret   atau   openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Wajib true saat di belakang proxy selain Vercel
# AUTH_TRUST_HOST=true

# --- Penyimpanan foto & musik -------------------------------------------------
# "local" = folder .uploads/ (hanya development; route /media & /api/upload
# otomatis MATI di production). "r2" = Cloudflare R2 (production).
STORAGE_DRIVER="local"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# URL publik bucket (custom domain / r2.dev), tanpa "/" di akhir
# R2_PUBLIC_URL="https://media.contoh.id"
# WAJIB: atur CORS bucket R2 agar browser boleh PUT (upload langsung) & GET
# (potong ulang foto di canvas) dari origin aplikasi, contoh:
#   [{"AllowedOrigins":["https://app.contoh.id"],"AllowedMethods":["GET","PUT"],
#     "AllowedHeaders":["Content-Type"],"MaxAgeSeconds":3600}]
# Rahasia pemanggil /api/cron/media-cleanup (Authorization: Bearer ...), min 16 karakter
# CRON_SECRET=""

# --- Midtrans (tahap pembayaran) ----------------------------------------------
# MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_SERVER_KEY=""
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
