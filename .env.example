# =============================================================================
# Salin ke .env lalu isi nilainya. JANGAN commit file .env.
# =============================================================================

# --- Aplikasi -----------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="Undangku"
# URL utama aplikasi (dashboard, landing)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database -----------------------------------------------------------------
# Lokal (docker compose): postgresql://undangan:undangan@localhost:5432/undangan
DATABASE_URL="postgresql://undangan:undangan@localhost:5432/undangan?schema=public"
# Staging/production (Neon, region Singapore):
#   DATABASE_URL          = string koneksi POOLED (host berisi "-pooler"), tambahkan &connect_timeout=15
#   DATABASE_URL_UNPOOLED = string koneksi LANGSUNG (tanpa "-pooler") — dipakai migrasi saat build
# DATABASE_URL_UNPOOLED=""

# Alat uji (pnpm seed:perf, pnpm e2e:*) MENOLAK berjalan bila DATABASE_URL bukan
# localhost, dan SELALU menolak bila NODE_ENV=production. Untuk staging saja:
# ALLOW_SEED_PERF=1   ← isi hanya di terminal saat menjalankan, JANGAN di Vercel
# Host database PRODUCTION yang tidak boleh disentuh alat uji sama sekali
# (bahkan dengan ALLOW_SEED_PERF=1), dipisah koma, mis. "ep-xxxx-12345":
# PROTECTED_DB_HOSTS=""

# --- Auth.js ------------------------------------------------------------------
# Buat dengan: npx auth secret   atau   openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Vercel: TIDAK perlu (otomatis dipercaya). Wajib true untuk `next start` lokal
# atau server sendiri di belakang proxy — tanpa ini login ditolak (UntrustedHost).
# AUTH_TRUST_HOST=true

# --- Penyimpanan foto & musik -------------------------------------------------
# "local" = folder .uploads/ (hanya development; route /media & /api/upload
# otomatis MATI di production). "r2" = Cloudflare R2 (production).
STORAGE_DRIVER="local"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# URL publik bucket (custom domain / r2.dev), tanpa "/" di akhir
# R2_PUBLIC_URL="https://media.contoh.id"
# WAJIB: atur CORS bucket R2 agar browser boleh PUT (upload langsung) & GET
# (potong ulang foto di canvas) dari origin aplikasi, contoh:
#   [{"AllowedOrigins":["https://app.contoh.id"],"AllowedMethods":["GET","PUT"],
#     "AllowedHeaders":["Content-Type"],"MaxAgeSeconds":3600}]
# Rahasia pemanggil /api/cron/media-cleanup & detail /api/health (Authorization:
# Bearer ...), min 16 karakter, huruf & angka saja. Vercel Cron mengirimnya otomatis.
# CRON_SECRET=""

# --- Midtrans (tahap pembayaran) ----------------------------------------------
# MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_SERVER_KEY=""
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
