// =============================================================================
// Skema database platform undangan digital
// -----------------------------------------------------------------------------
// Prinsip: DATA undangan disimpan sebagai JSON di Invitation.data (divalidasi
// Zod per jenis acara di src/schemas), sehingga tema bisa diganti kapan saja
// tanpa migrasi. Tabel relasional hanya untuk hal yang perlu di-query/di-index:
// tamu, RSVP, ucapan, order, dan statistik kunjungan.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enum
// -----------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
  /// Pembeli (marketplace / website): login hanya untuk mengelola undangannya
  /// sendiri — ubah data (tanpa ganti tema), ucapan, tamu, kirim undangan.
  CUSTOMER
}

/// Asal link khusus.
enum ClaimSource {
  MARKETPLACE
  WEBSITE
}

enum ClaimStatus {
  /// Pembeli sedang mengisi (boleh ganti tema berharga sama).
  OPEN
  /// Pembeli menekan "Pakai undangan ini": undangan tayang, tema terkunci.
  CONFIRMED
  /// Dicabut admin.
  REVOKED
}

enum EventType {
  WEDDING
  BIRTHDAY
  AQIQAH
  KHITANAN
  SYUKURAN
}

/// Isi pesanan (siap Midtrans, Tahap 5). Harga tema ada di manifest tema
/// (src/themes/*/manifest.ts), add-on di src/lib/pricing/addons.ts.
enum OrderItemKind {
  /// Beli tema pertama kali untuk undangan ini.
  THEME
  /// Pindah ke tema lebih mahal: bayar selisih (harga baru − kredit tema).
  THEME_UPGRADE
  ADDON
}

/// Draf gratis tanpa batas waktu; terbit hanya setelah tema dibeli. Penangguhan
/// oleh admin disimpan terpisah (Invitation.suspendedAt) agar status asli tetap.
enum InvitationStatus {
  DRAFT
  PUBLISHED
}

enum RsvpStatus {
  HADIR
  TIDAK_HADIR
  RAGU
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum MediaKind {
  PHOTO
  AUDIO
}

/// UPLOADING: URL upload sudah diberikan, file mentah belum/baru diunggah.
/// PROCESSING: file mentah diterima, sedang dikompres (musik diproses asinkron).
/// READY: file final siap dipakai. FAILED: gagal diproses (file mentah dihapus).
enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

// -----------------------------------------------------------------------------
// Auth.js (struktur standar @auth/prisma-adapter + field tambahan)
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// Hanya terisi untuk login email/password (bcrypt). Null untuk user OAuth.
  passwordHash  String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  invitations Invitation[]
  orders      Order[]
  media       Media[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Dipertahankan agar kompatibel dengan adapter, walau strategi session = JWT.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// Undangan
// -----------------------------------------------------------------------------

model Invitation {
  id            String           @id @default(cuid())
  userId        String
  /// Dipakai untuk subdomain {slug}.domain.id dan fallback /u/{slug}.
  slug          String           @unique
  eventType     EventType
  /// Merujuk ke manifest.id di src/themes/{theme-slug}.
  themeId       String
  /// Kunci palet dari manifest tema (mis. "sage", "navy").
  colorVariant  String?
  /// Data undangan; bentuknya ditentukan Zod schema sesuai eventType.
  data          Json             @default("{}")
  status        InvitationStatus @default(DRAFT)
  /// Null = masa uji (3 hari sejak terbit pertama + watermark). Diisi saat tema
  /// pertama kali dibeli; harga per tema, berlaku PER UNDANGAN.
  purchasedAt   DateTime?
  /// Total rupiah yang sudah dibayar untuk tema undangan ini. Pindah ke tema
  /// dengan harga ≤ kredit gratis; lebih mahal → bayar selisih.
  themeCredit   Int              @default(0)
  /// Tema yang sudah pernah dibayar untuk undangan ini (boleh kembali gratis).
  ownedThemeIds String[]         @default([])
  /// Mode privat (segera hadir): hanya tamu dengan link personal yang bisa membuka.
  isPrivate     Boolean          @default(false)
  /// Counter denormalisasi agar dashboard cepat; detail ada di InvitationView.
  viewCount     Int              @default(0)
  publishedAt   DateTime?
  /// Perubahan terakhir OLEH PENGGUNA di editor (autosave, alamat, template).
  /// Dasar retensi draf; proses sistem (cron, migrasi, skrip admin) tidak
  /// mengubahnya — berbeda dengan updatedAt.
  lastEditedAt  DateTime         @default(now())
  /// Retensi draf: foto & musik draf yang belum pernah dibeli dan tidak diubah
  /// 90 hari dihapus otomatis (teks tetap). Null = media masih ada / belum dibersihkan.
  mediaPurgedAt DateTime?
  /// Ditangguhkan admin (pelanggaran syarat). Selama terisi: halaman tamu, link
  /// pratinjau, gambar OG & API tamu → 404; pemilik tidak bisa menerbitkan.
  suspendedAt   DateTime?
  /// Alasan singkat yang ditampilkan ke pemilik.
  suspendReason String?
  /// Template pesan WhatsApp milik pemilik (null = template bawaan). Kolom
  /// terpisah dari `data` agar autosave editor tidak menimpanya.
  shareTemplate String?
  /// Masa aktif setelah tayang lewat link khusus (pengaturan global super admin
  /// saat konfirmasi). Selama belum lewat, pembeli bebas mengubah data.
  activeUntil   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  guests       Guest[]
  rsvps        Rsvp[]
  wishes       Wish[]
  orders       Order[]
  views        InvitationView[]
  media        Media[]
  addons       InvitationAddon[]
  previewLinks PreviewLink[]
  ownerLinks   OwnerLink[]
  booking      Booking?
  claim        ClaimLink?

  @@index([userId])
  @@index([status])
  @@index([purchasedAt, lastEditedAt])
}

/// Link pratinjau rahasia (/p/{token}) untuk ditunjukkan sebelum membeli.
/// Satu link aktif per undangan; hanya HASH token yang disimpan.
model PreviewLink {
  id           String    @id @default(cuid())
  invitationId String
  /// sha256(token) dalam hex — token asli hanya diketahui pemilik saat dibuat.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

model Guest {
  id              String    @id @default(cuid())
  invitationId    String
  name            String
  /// Slug tamu untuk link personal: {slug}.domain.id/?to={guestSlug}
  slug            String
  /// Grup bebas, mis. "Keluarga", "Teman Kantor".
  group           String?
  /// Nomor WA dinormalisasi ke format 62xxxxxxxxxx.
  phone           String?
  /// Id acara (dari Invitation.data.events[].id) yang boleh dihadiri.
  /// Array kosong = boleh menghadiri semua acara.
  allowedEventIds String[]  @default([])
  /// Waktu terakhir undangan dikirim lewat WA.
  sentAt          DateTime?
  /// Diisi saat QR check-in dipindai di lokasi acara.
  checkedInAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invitation Invitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  rsvps      Rsvp[]
  views      InvitationView[]

  @@unique([invitationId, slug])
  @@index([invitationId, group])
}

model Rsvp {
  id           String     @id @default(cuid())
  invitationId String
  /// Null jika RSVP dari link umum (tanpa nama tamu personal).
  guestId      String?
  name         String
  status       RsvpStatus
  /// Jumlah orang yang hadir.
  pax          Int        @default(1)
  message      String?
  /// Hash harian IP (+ rahasia server) untuk rate limit — IP mentah tidak disimpan.
  ipHash       String?
  /// Penanda perangkat acak dari cookie httpOnly (bukan data pribadi) — batas
  /// kiriman per perangkat; aman untuk tamu yang berbagi IP (CGNAT/Wi-Fi gedung).
  deviceId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([invitationId, status])
  @@index([guestId])
  @@index([invitationId, ipHash, createdAt])
  @@index([invitationId, deviceId, createdAt])
}

model Wish {
  id           String      @id @default(cuid())
  invitationId String
  name         String
  message      String
  /// Konfirmasi kehadiran yang dikirim bersama ucapan (lencana di Dinding Tamu).
  attendance   RsvpStatus?
  /// Pemilik undangan bisa menyembunyikan ucapan (spam/tidak pantas).
  isHidden     Boolean     @default(false)
  /// Hash harian IP (+ rahasia server) untuk rate limit — IP mentah tidak disimpan.
  ipHash       String?
  /// Penanda perangkat acak dari cookie httpOnly (bukan data pribadi) — batas
  /// kiriman per perangkat; aman untuk tamu yang berbagi IP (CGNAT/Wi-Fi gedung).
  deviceId     String?
  createdAt    DateTime    @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, createdAt])
  @@index([invitationId, ipHash, createdAt])
  @@index([invitationId, deviceId, createdAt])
}

/// Log kunjungan ringan untuk statistik "dibuka". Tidak menyimpan IP mentah.
model InvitationView {
  id           String   @id @default(cuid())
  invitationId String
  guestId      String?
  /// Hash harian (IP + UA + tanggal) untuk menghitung pengunjung unik.
  visitorHash  String?
  createdAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([invitationId, createdAt])
}

// -----------------------------------------------------------------------------
// Pembayaran (Midtrans Snap)
// -----------------------------------------------------------------------------

model Order {
  id              String      @id @default(cuid())
  invitationId    String
  userId          String
  /// Total rupiah = jumlah OrderItem.amount, disimpan saat order dibuat.
  amount          Int
  midtransOrderId String      @unique
  status          OrderStatus @default(PENDING)
  /// Mis. "qris", "gopay", "bank_transfer", "credit_card".
  paymentType     String?
  snapToken       String?
  /// Payload notifikasi terakhir dari webhook Midtrans (audit).
  rawNotification Json?
  paidAt          DateTime?
  /// Waktu item pesanan diterapkan ke undangan (idempoten: webhook ganda aman).
  appliedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  invitation Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      OrderItem[]

  @@index([invitationId])
  @@index([userId, status])
}

/// Satu baris pesanan: tema, selisih upgrade tema, atau add-on.
model OrderItem {
  id        String        @id @default(cuid())
  orderId   String
  kind      OrderItemKind
  /// themeId untuk THEME/THEME_UPGRADE, addonId untuk ADDON.
  refId     String
  /// Teks yang tampil di tagihan, mis. "Tema Renda Rimba".
  label     String
  unitPrice Int
  qty       Int           @default(1)
  amount    Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Add-on yang sudah dibeli untuk satu undangan (mis. foto galeri tambahan).
model InvitationAddon {
  id           String   @id @default(cuid())
  invitationId String
  addonId      String
  quantity     Int      @default(1)
  orderId      String?
  createdAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

/// Jejak audit tindakan admin manual (mis. pnpm admin:grant-theme).
model AdminAudit {
  id           String   @id @default(cuid())
  /// Nama/identitas pelaku yang diisi saat menjalankan + user OS.
  actor        String
  action       String
  invitationId String?
  detail       Json
  createdAt    DateTime @default(now())

  @@index([invitationId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Musik latar
// -----------------------------------------------------------------------------

model MusicTrack {
  id        String   @id @default(cuid())
  title     String
  artist    String?
  /// URL file audio (R2/CDN).
  url       String
  /// Durasi dalam detik.
  duration  Int?
  /// Mis. "romantis", "islami", "instrumental", "anak".
  category  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([isActive, category])
}

// -----------------------------------------------------------------------------
// File upload (foto & musik) — sumber kebenaran kepemilikan, kuota, dan
// penghapusan file lama. File disimpan lewat src/lib/storage (local / R2).
// -----------------------------------------------------------------------------

model Media {
  id                  String      @id @default(cuid())
  userId              String
  /// Null bila undangannya sudah dihapus (file dibersihkan oleh job pembersih).
  invitationId        String?
  kind                MediaKind
  /// Slot pemakaian, mis. "cover", "bride", "groom", "gallery", "strip",
  /// "closing", "loveStory", "qris", "music".
  slot                String
  status              MediaStatus @default(UPLOADING)
  /// Key file final di storage (terisi saat READY).
  key                 String?
  /// Key file mentah sebelum diproses (dihapus setelah READY/FAILED).
  rawKey              String?
  /// Tipe hasil deteksi magic bytes (bukan dari nama file / Content-Type).
  mime                String?
  /// Ukuran file final (byte) — dihitung ke kuota penyimpanan user.
  bytes               Int         @default(0)
  width               Int?
  height              Int?
  durationSec         Int?
  /// Upload musik sendiri: waktu user mencentang pernyataan hak penggunaan lagu.
  rightsAcceptedAt    DateTime?
  /// Kunci pemrosesan asinkron (musik): diisi saat route proses mengambil tugas,
  /// mencegah file yang sama diproses dua kali; job pembersih menggagalkan yang macet.
  processingStartedAt DateTime?
  /// Pesan galat untuk ditampilkan di editor bila FAILED.
  error               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([invitationId, slot])
  @@index([status, createdAt])
}

/// Status pesanan jasa: bayar dulu, baru dikerjakan.
enum BookingStatus {
  /// Form terkirim, menunggu pembayaran (admin mengirim QRIS).
  NEW
  /// Pembayaran diterima (ditandai admin).
  PAID
  /// Undangan sedang dikerjakan admin.
  PROCESSING
  /// Pratinjau dikirim ke pelanggan; revisi dihitung di revisionCount.
  AWAITING_APPROVAL
  PUBLISHED
  CANCELLED
}

/// Pesanan jasa pembuatan undangan dari form /pesan (tanpa login).
/// BEDA dengan Order (pembayaran tema): Order dibuat saat admin menandai lunas.
model Booking {
  id              String        @id @default(cuid())
  /// Kode pendek untuk pelanggan & WhatsApp, mis. "UND-7K3P".
  code            String        @unique
  themeId         String
  eventType       EventType
  /// Harga tema (rupiah) saat pesanan dibuat — sudah termasuk jasa.
  price           Int
  customerName    String
  /// Nomor WhatsApp ternormalisasi (62…).
  customerPhone   String
  /// Tanggal acara pertama (untuk daftar admin).
  eventDate       DateTime?
  /// Seluruh isian form (divalidasi schema form pemesanan).
  form            Json
  status          BookingStatus @default(NEW)
  /// Revisi yang sudah diminta (gratis maksimal 2).
  revisionCount   Int           @default(0)
  /// Catatan internal admin (tidak terlihat pelanggan).
  adminNote       String?
  /// Undangan yang dibuat admin dari pesanan ini.
  invitationId    String?       @unique
  consentAt       DateTime
  ipHash          String?
  deviceId        String?
  statusChangedAt DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@index([deviceId, createdAt])
}

/// Link pemilik untuk pelanggan (tanpa login): rekap kehadiran, kelola ucapan,
/// bagikan link tamu. Berlaku sampai dicabut admin; satu link aktif per undangan.
model OwnerLink {
  id           String    @id @default(cuid())
  invitationId String
  /// sha256(token) hex — token asli hanya tampil sekali saat dibuat.
  tokenHash    String    @unique
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

/// Link khusus (/isi/{token}): pembeli mengisi undangannya sendiri lewat form
/// bertahap + pratinjau, tanpa login. Dibuat admin (marketplace) atau otomatis
/// setelah bayar (website). Hanya HASH token yang disimpan. Belum dikonfirmasi
/// & lewat `expiresAt` → undangan draf + link dihapus otomatis (cron).
model ClaimLink {
  id               String      @id @default(cuid())
  /// Kode pendek untuk admin & pembeli, mis. "LK-7K3P".
  code             String      @unique
  tokenHash        String      @unique
  source           ClaimSource
  /// Nama marketplace (mis. "Shopee") & nomor pesanannya.
  marketplace      String?
  marketplaceOrder String?
  customerName     String
  /// Nomor WhatsApp ternormalisasi (62…).
  customerPhone    String?
  customerEmail    String?
  /// Harga tema yang dibayar (rupiah) — ganti tema hanya ke harga yang sama.
  price            Int
  /// Undangan draf milik link ini (dibuat bersama link).
  invitationId     String      @unique
  status           ClaimStatus @default(OPEN)
  /// Step form terakhir yang tersimpan (melanjutkan pengisian).
  step             Int         @default(0)
  expiresAt        DateTime
  confirmedAt      DateTime?
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  /// Admin pembuat (null bila dibuat otomatis oleh pembayaran website).
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([createdAt])
}

/// Pengaturan global yang diubah super admin (mis. batas waktu link khusus).
/// Nilai JSON per kunci; bawaan ada di src/lib/settings.ts.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
